[sub_resource type="GDScript" id="GDScript_yg2f7"]
script/source = "extends Node3D


@onready var _camera_3d_2 = $Node3D2/Camera3D2


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta):
	var guertin_sphynx_blur: GuertinSphynxMotionBlur = EasyCompositorUtils.get_or_add_active_compositor_effect(self, GuertinSphynxMotionBlur)
	
	if Input.is_action_just_pressed(\"ui_accept\"):
		guertin_sphynx_blur.enabled = !guertin_sphynx_blur.enabled
	
	if Input.is_action_just_pressed(\"ui_left\"):
		_camera_3d_2.current = true
	
	if Input.is_action_just_pressed(\"ui_right\"):
		_camera_3d_2.current = false
"

